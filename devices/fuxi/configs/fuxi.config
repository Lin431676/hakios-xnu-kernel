# HakiOS fragment: the Xiaomi 13 (fuxi, devices/fuxi) -- what is true of this phone and of no other with the same SoC.
# The vibration motor's variant (to be read from the phone's device tree), and where the modem's remote-file-system buffer is
# in its memory map (to be read from the phone's device tree; tools/soc-args.py makes it).
CONFIG_DEVICE="fuxi"
# CONFIG_HAPTIC is not set          # Awinic (variant to confirm from the phone's dtb)
# CONFIG_MODEM_BUFFER is not set    # SM8550 modem buffer address (to read from the phone's dtb)
