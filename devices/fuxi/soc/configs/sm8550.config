# HakiOS fragment: the Qualcomm SM8550 family ("kalama", "Snapdragon 8 Gen 2") -- what is true of the SoC, whatever phone it is in.
# The processor has eight cores: CPU0-2 Cortex-A510 (2.0 GHz), CPU3-4 Cortex-A715 (2.8 GHz),
# CPU5-6 Cortex-A710 (2.8 GHz), CPU7 Cortex-X3 (3.2 GHz). Boot CPU is CPU0 (A510); the biggest is CPU7.
# The addresses of this family (soc_*) are in the device's soc.args, read from its own tree; the kernel's defaults are
# the SC7280 family's and are overridden there.
CONFIG_SOC="sm8550"
CONFIG_CPUS=8
CONFIG_BOOTCPU=0
# The SoC-specific drivers (cpufreq/socinfo/thermal/pmic) are NOT enabled here yet: their SM8550 register addresses
# and device-tree data have not been ported from the SC7280 defaults. Enabling CONFIG_CPUFREQ/… here would emit
# boot-arguments nothing reads, which hakios-config refuses. Each comes back (with its CONFIG_* argument) once ported.
# CONFIG_CPUFREQ is not set
# CONFIG_SOCINFO is not set
# CONFIG_THERMAL is not set
# CONFIG_HAKIOS_CPUFREQ is not set
# CONFIG_HAKIOS_SOCINFO is not set
# CONFIG_HAKIOS_THERMAL is not set
# CONFIG_HAKIOS_PMIC is not set
